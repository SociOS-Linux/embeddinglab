{
  "schemaVersion": "functional-service.v1",
  "service": {
    "id": "embeddinglab.holmes.embedding-pilot",
    "name": "EmbeddingLab Holmes Embedding Pilot",
    "ownerRepository": "SociOS-Linux/embeddinglab",
    "status": "experimental",
    "description": "Offline deterministic embedding functional surface emitted by embeddinglab for governed promotion."
  },
  "function": "embedding",
  "model": {
    "modelRef": "urn:socioprophet:functional-model:embeddinglab:deterministic-embedding:v0",
    "adapterRefs": [],
    "runtime": "python-stdlib-offline-smoke",
    "mutableStatePolicy": "forbidden-in-sourceos"
  },
  "inputs": [
    "text/query",
    "text/corpus"
  ],
  "outputs": [
    "embedding/vector",
    "ranking/candidates",
    "evidence/smoke-receipt"
  ],
  "evals": {
    "required": true,
    "references": [
      "examples/smoke-input.json",
      "examples/smoke-output.json",
      "evidence/smoke-receipt.example.json"
    ],
    "minimumPromotionGate": "candidate requires signed eval and dataset provenance"
  },
  "governance": {
    "ledgerRequired": true,
    "guardrailRequired": true,
    "routingRequired": true,
    "policyRefs": [
      "SocioProphet/model-governance-ledger",
      "SocioProphet/guardrail-fabric",
      "SocioProphet/model-router",
      "SocioProphet/holmes"
    ]
  },
  "sourceosCarry": {
    "allowed": true,
    "carriesMutableModelState": true,
    "clientRefRequired": true,
    "launchProfileRefs": [
      "urn:srcos:model-carry:functional-service:embeddinglab-holmes-pilot"
    ]
  }
}
